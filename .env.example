# 复制为 .env 后填写。.env 不入库。
# 键名统一带 APP_ 前缀，与机器上其他项目的同名变量隔离，原因见 app/core/config.py。

# 数据模型层
# 端口 3308 而非 3306：宿主 3306 被本机原生 MySQL 5.7 服务占用，见 docker-compose.yml 注释
APP_DATABASE_URL=mysql+pymysql://root:dev123456@localhost:3308/bilingual_agents?charset=utf8mb4
APP_REDIS_URL=redis://localhost:6379/0

# 模型层（DeepSeek 走 OpenAI 兼容接口）
APP_DEEPSEEK_API_KEY=
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 可用：deepseek-v4-pro / deepseek-flash（均为推理模型）；deepseek-chat 为别名
APP_LLM_MODEL=deepseek-v4-pro
# 计算由大模型承担，温度必须为 0，否则同一输入得不到同一结果
APP_LLM_TEMPERATURE=0.0

# 检索与证据层
APP_EMBEDDING_MODEL=BAAI/bge-m3
APP_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# mysql | qdrant，见技术架构文档 2.3 节
APP_VECTOR_BACKEND=mysql

# 可复现性：任务创建时固化进 version_snapshot
APP_SCHEMA_VERSION=v0.1
APP_PROMPT_VERSION=v0.1

APP_UPLOAD_DIR=data/uploads
APP_MAX_UPLOAD_MB=200
# 原始年报数据集目录。刻意放在仓库外——168 份 PDF 约 500 MB，进版本库会让仓库爆掉
APP_DATASET_DIR=/path/to/数据来源
APP_DEBUG=false
